#!/usr/bin/env python3
"""Faux `gh` pour les tests SDLC : état dans $FAKE_STATE (JSON)."""
import json
import os
import sys

S = os.environ["FAKE_STATE"]
a = sys.argv[1:]


def load():
    return json.load(open(S))


def save(d):
    json.dump(d, open(S, "w"), indent=1)


def opt(name, default=None, multi=False):
    vals = [a[i + 1] for i, x in enumerate(a) if x == name]
    return vals if multi else (vals[0] if vals else default)


st = load()
if a[:2] == ["repo", "view"]:
    print(json.dumps({"nameWithOwner": os.environ.get("FAKE_REPO", "owner/proj")}))
elif a[:2] == ["issue", "list"] and opt("--search"):
    term = opt("--search").split("[", 1)[1].split("]", 1)[0]
    print(json.dumps([{"number": int(n), "title": i["title"]} for n, i in st["issues"].items()
                      if i["title"].startswith(f"[{term}]")]))
elif a[:2] == ["issue", "list"]:
    print(json.dumps([{"number": int(n), "title": i["title"], "body": i["body"]} for n, i in st["issues"].items()
                      if opt("--label") in i["labels"] and i["state"] == "OPEN"]))
elif a[:2] == ["issue", "create"]:
    n = str(len(st["issues"]) + 1)
    st["issues"][n] = {"title": opt("--title"), "body": sys.stdin.read(), "labels": [], "state": "OPEN", "comments": []}
    save(st)
    print(f"https://github.com/{opt('--repo')}/issues/{n}")
elif a[:2] == ["issue", "view"]:
    i = st["issues"][a[2]]
    print(json.dumps({"state": i["state"]} if opt("--json") == "state" else {"comments": i["comments"]}))
elif a[:2] == ["issue", "edit"]:
    i = st["issues"][a[2]]
    for l in opt("--remove-label", multi=True):
        if l in i["labels"]:
            i["labels"].remove(l)
    for l in opt("--add-label", multi=True):
        if l not in i["labels"]:
            i["labels"].append(l)
    save(st)
elif a[:2] == ["issue", "comment"]:
    i = st["issues"][a[2]]
    i["comments"].append({"id": f"IC_{a[2]}_{len(i['comments']) + 1}", "body": opt("--body"), "author": {"login": "sdlc-bot"}})
    save(st)
elif a[:2] == ["pr", "list"]:
    print(json.dumps([{"number": int(n)} for n, p in st["prs"].items() if p["head"] == opt("--head") and p["state"] == "OPEN"]))
elif a[:2] == ["pr", "create"]:
    n = str(len(st["prs"]) + 1)
    st["prs"][n] = {"head": opt("--head"), "title": opt("--title"), "body": sys.stdin.read(), "state": "OPEN"}
    save(st)
    print(f"https://github.com/{opt('--repo')}/pull/{n}")
else:
    print("fake gh : commande non gérée : " + " ".join(a), file=sys.stderr)
    sys.exit(1)
