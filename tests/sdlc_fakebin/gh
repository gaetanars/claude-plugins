#!/usr/bin/env python3
"""Faux `gh` pour les tests SDLC : `pr list` et `pr create`, état dans $FAKE_STATE (JSON)."""
import json
import os
import sys

S = os.environ["FAKE_STATE"]
a = sys.argv[1:]


def opt(name):
    return next((a[i + 1] for i, x in enumerate(a) if x == name), None)


st = json.load(open(S))
if a[:2] == ["pr", "list"]:
    print(json.dumps([{"number": int(n)} for n, p in st["prs"].items() if p["head"] == opt("--head") and p["state"] == "OPEN"]))
elif a[:2] == ["pr", "create"]:
    n = str(len(st["prs"]) + 1)
    st["prs"][n] = {"head": opt("--head"), "base": opt("--base"), "title": opt("--title"), "body": sys.stdin.read(), "state": "OPEN"}
    json.dump(st, open(S, "w"), indent=1)
    print(f"https://github.com/owner/proj/pull/{n}")
else:
    print("fake gh : commande non gérée : " + " ".join(a), file=sys.stderr)
    sys.exit(1)
