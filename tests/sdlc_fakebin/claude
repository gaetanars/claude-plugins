#!/usr/bin/env python3
"""Faux `claude -p` : réponses scénarisées par agent. Scénario dans $FAKE_CLAUDE_DIR/scenario."""
import json
import os
import subprocess
import sys

argv = sys.argv[1:]
prompt = sys.stdin.read()
agent = argv[argv.index("--agent") + 1].split(":", 1)[1]
d = os.environ["FAKE_CLAUDE_DIR"]
scen = open(os.path.join(d, "scenario")).read().strip()
with open(os.path.join(d, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"agent": agent, "argv": argv, "prompt": prompt, "role": os.environ.get("SDLC_ROLE"),
                        "has_gh_token": "GH_TOKEN" in os.environ, "worktree": os.environ.get("SDLC_WORKTREE"),
                        "cwd": os.getcwd()}) + "\n")


def counter(name):
    p = os.path.join(d, f"count-{name}")
    n = int(open(p).read()) + 1 if os.path.exists(p) else 1
    open(p, "w").write(str(n))
    return n


def out(so):
    print(json.dumps({"result": "", "structured_output": so, "total_cost_usd": 0.01, "num_turns": 2, "is_error": False,
                      "subtype": "success", "permission_denials": []}))
    sys.exit(0)


if agent == "planner":
    if scen == "ambiguity" and counter("planner") == 1:
        out({"plan_md": "", "adrs": [], "ambiguities": [{"question": "Quel format de sortie ?", "why_blocking": "change le contrat"}]})
    out({"plan_md": "# Plan\n\n## Étapes\n### Étape 1\nCréer hello.txt\n", "ambiguities": [],
         "adrs": [{"slug": "Choix simple", "title": "Choix simple", "content_md": "## Statut\nAccepté\n\n## Décision\nFichier texte."}]})
if agent == "implementer":
    n = counter("impl")
    # scénarios « check_red_then_green » / « arch_red_then_green » : le 1er passage laisse un marqueur que le gate refuse
    marker = {"check_red_then_green": "BAD\n", "arch_red_then_green": "FORBIDDEN\n"}.get(scen) if n == 1 else None
    overwrite = scen in ("check_red_then_green", "arch_red_then_green")
    open(os.path.join(os.getcwd(), "hello.txt"), "w" if overwrite else "a").write(marker or f"v{n}\n")
    if scen == "touch_arch":  # tentative de contournement : l'implementer modifie l'architecture verrouillée
        with open(os.path.join(os.getcwd(), "docs", "architecture", "ARCHITECTURE.md"), "a") as f:
            f.write("\nrègle assouplie\n")
    subprocess.run(["git", "add", "-A"], check=True)
    subprocess.run(["git", "commit", "-q", "-m", f"feat(hello): itération {n}", "-m", "Feature: 0001-hello\nPlan-Step: 1"], check=True)
    out({"status": "done", "summary": f"itération {n}", "tests": {"command": "true", "result": "ok"},
         "deviations": [], "ambiguities": [], "findings_response": []})
if agent.startswith("reviewer-"):
    axis = agent.split("-", 1)[1]
    n = counter("rev-" + axis)
    bad = axis == "security" and (scen == "always_reject" or (scen == "reject_once" and n == 1))
    if bad:
        out({"verdict": "changes_requested", "summary": "faille",
             "findings": [{"severity": "blocker", "file": "hello.txt", "line": 1, "issue": "secret en clair",
                           "evidence": "ligne 1", "suggestion": "retirer"}]})
    if scen == "liar" and axis == "simplicity":  # approuve malgré un finding major : doit être requalifié
        out({"verdict": "approve", "summary": "ok", "findings": [{"severity": "major", "file": "hello.txt", "line": 1,
             "issue": "surface inutile", "evidence": "x", "suggestion": "retirer"}]}) if n == 1 else None
    out({"verdict": "approve", "summary": "ok", "findings": []})
print("agent inconnu : " + agent, file=sys.stderr)
sys.exit(1)
