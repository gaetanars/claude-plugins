#!/usr/bin/env python3
"""Exécute une pièce du projet avec le Python du venv fdm (python -m fdm_tools.run)."""
import argparse
import os
import subprocess
import sys
from pathlib import Path


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--data")
    ap.add_argument("piece")
    ap.add_argument("args", nargs=argparse.REMAINDER)
    args = ap.parse_args()

    data = args.data or os.environ.get("CLAUDE_PLUGIN_DATA")
    if not data:
        sys.exit("erreur : dossier de données absent, passer --data ou définir CLAUDE_PLUGIN_DATA")
    python = Path(data) / "venv" / "bin" / "python"
    if not python.exists():
        sys.exit(f"erreur : venv absent ({python}), lancer fdm-setup")
    if not os.path.isfile(args.piece):
        sys.exit(f"erreur : pièce introuvable : {args.piece}")

    lib = Path(__file__).resolve().parent.parent / "lib"
    old = os.environ.get("PYTHONPATH")
    env = dict(os.environ, PYTHONPATH=os.pathsep.join([str(lib)] + ([old] if old else [])), FDM_DATA=str(data))
    try:
        r = subprocess.run([str(python), "-m", "fdm_tools.run", args.piece, *args.args], env=env)
    except OSError as e:
        sys.exit(f"erreur : lancement de {python} impossible : {e}")
    sys.exit(r.returncode)


if __name__ == "__main__":
    main()
