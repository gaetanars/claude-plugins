#!/usr/bin/env bash
# sdlc-template <nom> — affiche un gabarit du contrat (brief, spec, ambiguities, plan, adr, project-CLAUDE).
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
name="${1:-}"
if [[ -z "$name" || ! -f "$root/templates/$name.md" ]]; then
  echo "usage: sdlc-template <$(ls "$root/templates" | sed 's/\.md$//' | paste -sd'|' -)>" >&2
  exit 1
fi
cat "$root/templates/$name.md"
