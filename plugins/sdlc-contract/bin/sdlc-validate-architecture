#!/usr/bin/env python3
"""sdlc-validate-architecture [--require-accepted] <docs/architecture> — valide le cadrage d'architecture d'un projet.

Contrôles : ARCHITECTURE.md (frontmatter, sections), rules.json (modules, dépendances acycliques, outil natif et
configuration sous docs/architecture/native/), cohérence entre les deux, cohérence des ADR (docs/adr/, frère du dossier docs/).
--require-accepted : refuse `status: draft` (publication et sdlc-run l'exigent).
Sortie : 0 = valide ; 1 = erreurs listées sur stderr ; 2 = usage.
"""
import json
import re
import sys
from pathlib import Path

SUPPORTED_SCHEMA = {"1"}
STATUSES = {"draft", "accepted"}
SECTIONS = ["Contexte et objectifs", "Stack", "Modules", "Règles de dépendance", "Principes et interdits",
            "Exige un ADR", "Contrôle mécanique"]
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
NATIVE_PREFIX = "docs/architecture/native/"
ADR_STATUS = re.compile(r"^(Accepté|Proposé|Déprécié|Remplacé par (\d{4}))\b")  # début de la 1re ligne : tolère un commentaire derrière
PLACEHOLDERS = re.compile(r"\b(TODO|TBD|FIXME|NNNN)\b|\?\?\?|à définir|a definir", re.I)
FENCE = re.compile(r"^```.*?^```", re.S | re.M)


def parse_frontmatter(text):
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    if not m:
        return None, text
    fm = {}
    for line in m.group(1).splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            fm[k.strip()] = v.strip()
    return fm, m.group(2)


def sections(body):
    out, cur = {}, None
    for line in body.splitlines():
        m = re.match(r"##\s+(.+?)\s*$", line)
        if m:
            cur = m.group(1)
            out[cur] = []
        elif cur is not None:
            out[cur].append(line)
    return {k: "\n".join(v).strip() for k, v in out.items()}


def has_cycle(graph):
    state = {}

    def visit(n):
        state[n] = 1
        for m in graph.get(n, []):
            if state.get(m) == 1 or (m not in state and visit(m)):
                return True
        state[n] = 2
        return False

    return any(n not in state and visit(n) for n in graph)


def check_rules(adir, errs):
    p = adir / "rules.json"
    try:
        rules = json.loads(p.read_text(encoding="utf-8"))
    except ValueError as e:
        errs.append(f"rules.json illisible : {e}")
        return None
    if not isinstance(rules, dict):
        errs.append("rules.json : objet attendu")
        return None
    if str(rules.get("schema_version")) not in SUPPORTED_SCHEMA:
        errs.append(f"rules.json : schema_version {rules.get('schema_version')!r} non supporté (attendu {sorted(SUPPORTED_SCHEMA)})")
    mods = rules.get("modules")
    names = []
    if not isinstance(mods, list) or not mods:
        errs.append("rules.json : modules doit être une liste non vide")
        mods = []
    for m in mods:
        n = m.get("name") if isinstance(m, dict) else None
        if not isinstance(n, str) or not NAME_RE.match(n):
            errs.append(f"rules.json : nom de module invalide {n!r} (kebab-case attendu)")
            continue
        if n in names:
            errs.append(f"rules.json : module dupliqué {n!r}")
        names.append(n)
        paths = m.get("paths")
        if not isinstance(paths, list) or not paths or not all(isinstance(x, str) and x.strip() for x in paths):
            errs.append(f"rules.json : module {n!r} : paths doit être une liste non vide de chaînes")
    allowed = rules.get("allowed_dependencies")
    if not isinstance(allowed, dict):
        errs.append("rules.json : allowed_dependencies (objet) manquant")
    else:
        for n in names:
            if n not in allowed:
                errs.append(f"rules.json : allowed_dependencies sans entrée pour {n!r} (liste vide si aucune dépendance)")
        for src, dsts in allowed.items():
            if src not in names:
                errs.append(f"rules.json : allowed_dependencies : module inconnu {src!r}")
            if not isinstance(dsts, list):
                errs.append(f"rules.json : allowed_dependencies[{src!r}] doit être une liste")
                continue
            for d in dsts:
                if d not in names:
                    errs.append(f"rules.json : {src!r} dépend du module inconnu {d!r}")
                elif d == src:
                    errs.append(f"rules.json : {src!r} dépend de lui-même")
        if not errs and has_cycle({k: v for k, v in allowed.items() if isinstance(v, list)}):
            errs.append("rules.json : cycle dans allowed_dependencies")
    native = rules.get("native")
    if not isinstance(native, dict) or not str(native.get("tool", "")).strip():
        errs.append("rules.json : native.tool manquant (outil de contrôle du langage)")
        native = {}
    for key, required in (("config", True), ("baseline", False)):
        v = native.get(key)
        if v is None:
            if required:
                errs.append(f"rules.json : native.{key} manquant")
            continue
        if not isinstance(v, str) or not v.startswith(NATIVE_PREFIX) or ".." in v:
            errs.append(f"rules.json : native.{key} doit être sous {NATIVE_PREFIX} (reçu {v!r})")
        elif not (adir.parent.parent / v).is_file():
            errs.append(f"rules.json : native.{key} introuvable : {v}")
    return rules


def check_adrs(adir, errs):
    d = adir.parent / "adr"
    if not d.is_dir():
        return
    numbers = {}
    for p in sorted(d.glob("*.md")):
        m = re.match(r"(\d{4})-", p.name)
        if not m:
            continue
        if m.group(1) in numbers:
            errs.append(f"docs/adr : numéro {m.group(1)} dupliqué ({numbers[m.group(1)]}, {p.name})")
        numbers[m.group(1)] = p.name
    for p in sorted(d.glob("*.md")):
        if not re.match(r"\d{4}-", p.name):
            continue
        sec = sections(p.read_text(encoding="utf-8"))
        st = (sec.get("Statut", "").strip().splitlines() or [""])[0].strip()
        m = ADR_STATUS.match(st)
        if not m:
            errs.append(f"docs/adr/{p.name} : Statut invalide {st!r} (Accepté, Proposé, Déprécié, Remplacé par NNNN)")
        elif m.group(2) and m.group(2) not in numbers:
            errs.append(f"docs/adr/{p.name} : remplacée par l'ADR {m.group(2)} qui n'existe pas")


def validate(adir: Path, require_accepted=False):
    errs = []
    if not adir.is_dir():
        return [f"{adir.name}/ absent : cadrer l'architecture avec /sdlc-framing:architect"]
    md, rj = adir / "ARCHITECTURE.md", adir / "rules.json"
    for f in (md, rj):
        if not f.is_file():
            errs.append(f"{f.name} manquant")
    if errs:
        return errs
    text = md.read_text(encoding="utf-8")
    fm, body = parse_frontmatter(text)
    if fm is None:
        errs.append("ARCHITECTURE.md : frontmatter absent")
    else:
        if fm.get("schema_version") not in SUPPORTED_SCHEMA:
            errs.append(f"ARCHITECTURE.md : schema_version {fm.get('schema_version')!r} non supporté (attendu {sorted(SUPPORTED_SCHEMA)})")
        if fm.get("status") not in STATUSES:
            errs.append(f"ARCHITECTURE.md : status doit être draft ou accepted (reçu {fm.get('status')!r})")
        elif require_accepted and fm["status"] != "accepted":
            errs.append("ARCHITECTURE.md : status draft : valider l'architecture avec /sdlc-framing:architect")
        if not re.match(r"^\d{4}-\d{2}-\d{2}$", fm.get("updated", "")):
            errs.append("ARCHITECTURE.md : updated doit être AAAA-MM-JJ")
    secs = sections(body)
    for s in SECTIONS:
        if s not in secs:
            errs.append(f"ARCHITECTURE.md : section « {s} » manquante")
        elif len(secs[s]) < 10:
            errs.append(f"ARCHITECTURE.md : section « {s} » vide ou trop courte")
    if not re.search(r"^\s*[-*] \S", secs.get("Exige un ADR", ""), re.M):
        errs.append("ARCHITECTURE.md : « Exige un ADR » doit lister au moins un élément")
    for n, line in enumerate(FENCE.sub("", text).splitlines(), 1):
        if PLACEHOLDERS.search(line):
            errs.append(f"ARCHITECTURE.md : marqueur d'incomplétude : {line.strip()[:80]!r}")
            break
    rules = check_rules(adir, errs)
    if rules:
        modules_text = secs.get("Modules", "")
        for m in rules.get("modules", []):
            n = m.get("name") if isinstance(m, dict) else None
            if isinstance(n, str) and f"`{n}`" not in modules_text:
                errs.append(f"ARCHITECTURE.md : module `{n}` (rules.json) absent de la section « Modules » (le citer entre accents graves)")
        tool = str((rules.get("native") or {}).get("tool", "")).strip()
        if tool and tool.lower() not in secs.get("Contrôle mécanique", "").lower():
            errs.append(f"ARCHITECTURE.md : « Contrôle mécanique » ne mentionne pas l'outil {tool!r}")
    check_adrs(adir, errs)
    return errs


def main(argv):
    args = [a for a in argv[1:] if a != "--require-accepted"]
    if len(args) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    adir = Path(args[0]).resolve()
    errs = validate(adir, "--require-accepted" in argv[1:])
    if errs:
        print(f"Architecture invalide ({len(errs)} erreur(s)) :", file=sys.stderr)
        for e in errs:
            print(f"- {e}", file=sys.stderr)
        return 1
    print("OK : architecture")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
