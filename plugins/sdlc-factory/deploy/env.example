# /etc/sdlc/env (chmod 600, propriétaire sdlc) — jamais commité
# Jeton fine-grained du COMPTE BOT, limité aux dépôts concernés :
#   Contents RW, Pull requests RW, Issues RW, Commit statuses RW, Metadata R. Aucun droit d'administration.
GH_TOKEN=github_pat_xxx
SDLC_HOME=/opt/sdlc
SDLC_WORKDIR=/home/sdlc/work
SDLC_REPOS_FILE=/etc/sdlc/repos
HOME=/home/sdlc

# Itérations de correction avant escalade (défaut 3)
SDLC_MAX_ITER=3
# Plafond de dépense par appel d'agent, en USD (optionnel)
#SDLC_BUDGET_USD=5
# Identité des commits de l'automate
SDLC_GIT_NAME=sdlc-bot
SDLC_GIT_EMAIL=sdlc-bot@users.noreply.github.com
# Authentification de Claude : soit `claude` connecté (login) pour l'utilisateur sdlc, soit une clé API :
#ANTHROPIC_API_KEY=sk-ant-xxx

# Domaines joignables depuis le sandbox des commandes Bash des agents (séparés par des virgules)
#SDLC_ALLOWED_DOMAINS=pypi.org,files.pythonhosted.org,registry.npmjs.org
# Délai du `check` exécuté par l'orchestrateur, en secondes (défaut 1800)
#SDLC_CHECK_TIMEOUT=1800
# Dépôts : /etc/sdlc/repos, un OWNER/REPO par ligne ; suffixe ` automerge` pour armer l'auto-merge (opt-in, CI requise)
