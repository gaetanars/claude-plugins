{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sortie du planner",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_md", "adrs", "ambiguities"],
  "properties": {
    "plan_md": { "type": "string" },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "content_md"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "content_md": { "type": "string" }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "why_blocking"],
        "properties": {
          "question": { "type": "string" },
          "why_blocking": { "type": "string" }
        }
      }
    }
  }
}
