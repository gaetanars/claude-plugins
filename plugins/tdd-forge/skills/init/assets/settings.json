{
  "permissions": {
    "allow": [
      "Workflow(tdd-forge:deliver)",
      "Bash(python3 .forge/bin/forge.py *)",
      "Bash(cd .forge/worktrees/*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  }
}
