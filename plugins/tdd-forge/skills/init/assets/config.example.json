{
  "version": 1,
  "stack": "<libellé informatif>",
  "default_branch": "main",
  "remote": "origin",
  "test_globs": ["<motifs des fichiers de test>"],
  "acceptance_globs": ["<motifs des tests d'acceptation>"],
  "results_path": ".forge/out/results.json",
  "test_cmd": "<commande de test qui écrit results_path et sort en erreur si un test échoue>",
  "gates": [
    { "name": "tests", "cmd": "<commande de test>", "tests": true }
  ],
  "suppression_markers": [],
  "max_pr_lines": 400,
  "stall_rounds": 2,
  "auto_merge": true,
  "merge_method": "squash"
}
